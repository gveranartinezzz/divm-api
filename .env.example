APP_NAME="DIVM Educación Especial API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Base de datos (mismos datos que usabas en Laragon) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=divm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------- Sanctum (API tokens) ----------
# Dominios desde los que tu SPA/app puede hacer login con cookies (opcional, no es
# necesario si usas los endpoints como una API de tokens puros, como está montada aquí).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# CORS: pon aquí el dominio de tu frontend en producción, o deja "*" en desarrollo.
CORS_ALLOWED_ORIGINS=*

# ---------- Correo (para el código 2FA), usa un App Password de Gmail ----------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM_ADDRESS="tu_correo@gmail.com"
MAIL_FROM_NAME="DIVM Educación Especial"

# ---------- Chatbot (Groq) ----------
# NUNCA subas tu API key real a git; solo va en este .env local/del servidor.
GROQ_API_KEY=
